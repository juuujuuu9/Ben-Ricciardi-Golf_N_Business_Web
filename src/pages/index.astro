		.carousel-slide-mobile.prev {
			transform: translateX(-280px) rotateY(-5deg) translateZ(-50px) !important;
			opacity: 0 !important;
			visibility: hidden !important;
			pointer-events: none !important;
			width: calc(100% - 40px) !important;
			height: 280px !important;
		}
		
		.carousel-slide-mobile.next {
			transform: translateX(280px) rotateY(5deg) translateZ(-50px) !important;
			opacity: 0 !important;
			visibility: hidden !important;
			pointer-events: none !important;
			width: calc(100% - 40px) !important;
			height: 280px !important;
		}
	</style>

	<script>
		// Desktop carousel state
		let currentSlide = 1;
		const totalSlides = 3;
		
		// Mobile carousel state
		let currentSlideMobile = 1;
		
		function updateCarousel() {
			const slides = document.querySelectorAll('.carousel-slide');
			const track = document.getElementById('carouselTrack');
			
			slides.forEach((slide, index) => {
				slide.classList.remove('active', 'prev', 'next');
				
				// Reset text sizing
				const title = slide.querySelector('h3');
				const description = slide.querySelector('p');
				const textContainer = slide.querySelector('.absolute.bottom-4, .absolute.bottom-6');
				
				if (index === currentSlide) {
					slide.classList.add('active');
					// Active slide - full size text
					if (title) {
						title.className = 'text-xl font-bold mb-2';
					}
					if (description) {
						description.className = 'text-sm opacity-90';
					}
					if (textContainer) {
						textContainer.className = 'absolute bottom-6 left-6 text-white';
					}
				} else if (index === (currentSlide - 1 + totalSlides) % totalSlides) {
					slide.classList.add('prev');
					// Side slide - smaller text
					if (title) {
						title.className = 'text-lg font-bold mb-1';
					}
					if (description) {
						description.className = 'text-xs opacity-90';
					}
					if (textContainer) {
						textContainer.className = 'absolute bottom-4 left-4 text-white';
					}
				} else if (index === (currentSlide + 1) % totalSlides) {
					slide.classList.add('next');
					// Side slide - smaller text
					if (title) {
						title.className = 'text-lg font-bold mb-1';
					}
					if (description) {
						description.className = 'text-xs opacity-90';
					}
					if (textContainer) {
						textContainer.className = 'absolute bottom-4 left-4 text-white';
					}
				}
			});
		}
		
		function updateCarouselMobile() {
			const slides = document.querySelectorAll('.carousel-slide-mobile');
			
			slides.forEach((slide, index) => {
				slide.classList.remove('active', 'prev', 'next');
				
				if (index === currentSlideMobile) {
					slide.classList.add('active');
				} else if (index === (currentSlideMobile - 1 + totalSlides) % totalSlides) {
					slide.classList.add('prev');
				} else if (index === (currentSlideMobile + 1) % totalSlides) {
					slide.classList.add('next');
				}
			});
		}
		
		function nextSlide() {
			currentSlide = (currentSlide + 1) % totalSlides;
			updateCarousel();
		}
		
		function previousSlide() {
			currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
			updateCarousel();
		}
		
		function nextSlideMobile() {
			currentSlideMobile = (currentSlideMobile + 1) % totalSlides;
			updateCarouselMobile();
		}
		
		function previousSlideMobile() {
			currentSlideMobile = (currentSlideMobile - 1 + totalSlides) % totalSlides;
			updateCarouselMobile();
		}
		
		// Initialize carousels
		document.addEventListener('DOMContentLoaded', function() {
			// Desktop carousel
			updateCarousel();
			
			const prevBtn = document.getElementById('prevBtn');
			const nextBtn = document.getElementById('nextBtn');
			
			if (prevBtn) {
				prevBtn.addEventListener('click', function(e) {
					e.preventDefault();
					previousSlide();
				});
			}
			
			if (nextBtn) {
				nextBtn.addEventListener('click', function(e) {
					e.preventDefault();
					nextSlide();
				});
			}
			
			// Mobile carousel
			updateCarouselMobile();
			
			const prevBtnMobile = document.getElementById('prevBtnMobile');
			const nextBtnMobile = document.getElementById('nextBtnMobile');
			
			if (prevBtnMobile) {
				prevBtnMobile.addEventListener('click', function(e) {
					e.preventDefault();
					previousSlideMobile();
				});
			}
			
			if (nextBtnMobile) {
				nextBtnMobile.addEventListener('click', function(e) {
					e.preventDefault();
					nextSlideMobile();
				});
			}
			
			// Auto-play functionality (optional)
			setInterval(nextSlide, 5000);
			setInterval(nextSlideMobile, 5000);
		});
		
		// Touch/swipe support for mobile carousel
		let touchStartX = 0;
		let touchStartY = 0;
		let touchEndX = 0;
		let touchEndY = 0;
		let isDragging = false;
		
		// Wait for DOM to be ready
		document.addEventListener('DOMContentLoaded', function() {
			const mobileCarouselContainer = document.getElementById('carouselTrackMobile');
			if (!mobileCarouselContainer) return;
			
			// Find the parent container that wraps the carousel
			const carouselWrapper = mobileCarouselContainer.closest('.carousel-container') || mobileCarouselContainer.parentElement;
			if (!carouselWrapper) return;
			
			carouselWrapper.addEventListener('touchstart', function(e) {
				const touchEvent = e as TouchEvent;
				touchStartX = touchEvent.touches[0].clientX;
				touchStartY = touchEvent.touches[0].clientY;
				isDragging = true;
			}, { passive: true });
			
			carouselWrapper.addEventListener('touchmove', function(e) {
				if (!isDragging) return;
				
				const touchEvent = e as TouchEvent;
				const currentX = touchEvent.touches[0].clientX;
				const currentY = touchEvent.touches[0].clientY;
				const deltaX = Math.abs(currentX - touchStartX);
				const deltaY = Math.abs(currentY - touchStartY);
				
				// If horizontal movement is greater than vertical, prevent default scrolling
				if (deltaX > deltaY && deltaX > 10) {
					e.preventDefault();
				}
			}, { passive: false });
			
			carouselWrapper.addEventListener('touchend', function(e) {
				if (!isDragging) return;
				
				const touchEvent = e as TouchEvent;
				touchEndX = touchEvent.changedTouches[0].clientX;
				touchEndY = touchEvent.changedTouches[0].clientY;
				
				const diffX = touchStartX - touchEndX;
				const diffY = Math.abs(touchStartY - touchEndY);
				const threshold = 50;
				
				// Only trigger swipe if horizontal movement is greater than vertical (prevents accidental swipes when scrolling)
				if (Math.abs(diffX) > threshold && Math.abs(diffX) > diffY) {
					if (diffX > 0) {
						// Swiped left - next slide
						nextSlideMobile();
					} else {
						// Swiped right - previous slide
						previousSlideMobile();
					}
				}
				
				isDragging = false;
			}, { passive: true });
		});
		
		// Accordion functionality
		function toggleAccordion(index: number, event?: MouseEvent | Event) {
			// Find the clicked button element
			const clickedButton = (event?.target as HTMLElement)?.closest('.accordion-header') as HTMLElement || 
				((event?.target as HTMLElement)?.tagName === 'BUTTON' ? (event?.target as HTMLElement) : null) || 
				document.querySelectorAll('.accordion-header')[index] as HTMLElement;
			if (!clickedButton) return;
			
			// Find the accordion item that contains this button
			const accordionItem = clickedButton.closest('.accordion-item') as HTMLElement;
			if (!accordionItem) return;
			
			// Find the parent container that holds all accordion items for this section
			// Try multiple selectors to find the container
			let accordionContainer: HTMLElement | null = accordionItem.parentElement as HTMLElement;
			// Look for a container that has multiple accordion-item children
			while (accordionContainer && accordionContainer.querySelectorAll('.accordion-item').length < 2) {
				accordionContainer = accordionContainer.parentElement as HTMLElement;
			}
			
			if (!accordionContainer) return;
			
			// Get accordion items only within this container
			const accordionItems = accordionContainer.querySelectorAll('.accordion-item');
			
			const accordionContent = accordionItem.querySelector('.accordion-content') as HTMLElement;
			const accordionButton = accordionItem.querySelector('.accordion-header') as HTMLElement;
			const arrow = accordionButton?.querySelector('.accordion-arrow') as HTMLElement;
			
			if (!accordionContent || !accordionButton || !arrow) return;
			
			// Check if current item is already open
			const isCurrentlyOpen = accordionContent.style.maxHeight !== '0px' && accordionContent.style.maxHeight !== '';
			
			// If the clicked item is already open, do nothing (prevent jerky animation)
			if (isCurrentlyOpen) {
				return;
			}
			
			// Close all accordion items first (only within this container)
			accordionItems.forEach((item: Element) => {
				const content = item.querySelector('.accordion-content') as HTMLElement;
				const button = item.querySelector('.accordion-header') as HTMLElement;
				const itemArrow = button?.querySelector('.accordion-arrow') as HTMLElement;
				
				if (content && itemArrow) {
					content.style.maxHeight = '0';
					// Rotate arrow to point right (closed state) - -90deg for chevron pointing right
					itemArrow.style.transform = 'rotate(-90deg)';
					// Remove active state
					button.classList.remove('bg-gray-800/20');
				}
			});
			
			// Open the clicked item
			// Temporarily set max-height to auto to get the full height
			accordionContent.style.maxHeight = 'none';
			const fullHeight = accordionContent.scrollHeight;
			accordionContent.style.maxHeight = '0';
			
			// Use requestAnimationFrame for smooth animation
			requestAnimationFrame(() => {
				accordionContent.style.maxHeight = fullHeight + 'px';
			});
			
			// Rotate arrow to point down (open state) - 0deg for chevron pointing down
			arrow.style.transform = 'rotate(0deg)';
			accordionButton.classList.add('bg-gray-800/20');
		}
		
		// Make toggleAccordion globally available
		(window as any).toggleAccordion = toggleAccordion;

		
		// Initialize accordion on page load
		document.addEventListener('DOMContentLoaded', function() {
			// Set initial state for first accordion item (expanded)
			const firstAccordion = document.querySelector('.accordion-item') as HTMLElement;
			if (firstAccordion) {
				const firstButton = firstAccordion.querySelector('.accordion-header') as HTMLElement;
				const firstArrow = firstButton?.querySelector('.accordion-arrow') as HTMLElement;
				
				if (firstButton && firstArrow) {
					firstButton.classList.add('bg-gray-800/20');
					// Set arrow to point down (open state) for first item
					firstArrow.style.transform = 'rotate(0deg)';
				}
			}
			
			// Add event listeners as backup to ensure clicks work
			const accordionButtons = document.querySelectorAll('.accordion-header');
			accordionButtons.forEach((button, index) => {
				button.addEventListener('click', function(e) {
					e.preventDefault();
					(window as any).toggleAccordion(index, e);
				});
			});
		});
	</script>
	</div>
	<!-- End Desktop Layout -->

</Layout>