---
import Layout from '../components/Layout.astro';
import heroBannerImage from '../../public/assets/img/img-herobanner.png';
import rectangleImage from '../../public/assets/img/rectangle-1.png';
import thumbImage from '../../public/assets/img/thumb-1.jpg';
import thumb2Image from '../../public/assets/img/thumb-2.jpg';
import videoThumbImage from '../../public/assets/img/maxresdefault-webp-1.png';
import youtubeShortsSvg from '../../public/assets/youtube-shorts.svg';
import customImage from '../../public/assets/img/363504b4e12a145512a97e26fa1441c91c34899d.jpg';
---

<Layout title="Ben Ricciardi" description="Ben Ricciardi's personal website" currentPage="home">
	<!-- Mobile Layout (visible on screens < lg) -->
	<div class="block lg:hidden bg-black relative w-full min-h-screen overflow-x-hidden">
		<!-- Mobile Menu Icon -->
		<button class="absolute right-5 top-[34px] w-10 h-10 flex items-center justify-center" aria-label="Menu">
			<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>

		<!-- Hero Banner Section -->
		<section class="pt-[114px] px-5 pb-20">
			<div class="flex flex-col gap-8 items-center w-full  mx-auto">
				<!-- Action Text -->
				<div class="flex gap-5 items-center w-full">
					<div class="w-[25px] h-0.5 bg-[#d63a2e] shrink-0 -mt-0.5"></div>
					<p class="text-white text-base font-aktiv uppercase leading-6 tracking-[4px]">On the Course and in Business</p>
				</div>

				<!-- Titular -->
				<div class="flex flex-col gap-7 items-start w-full">
					<h1 class="text-white text-[96px] font-gazzetta-bold uppercase leading-[80px] tracking-[-1px] break-words">Power, Precision, and Performance</h1>
					<p class="text-[#707070] text-xl font-aktiv-medium leading-7">
						Driven by passion for golf and the thrill of creating meaningful business connections,<br>
						<span class="font-aktiv-bold text-[#d63a2e]">Ben Ricciardi</span> brings energy, influence, and results to every round and every deal.
					</p>
				</div>

				<!-- Hero Image -->
				<div class="relative h-[50vh] w-full rounded-[10px] rounded-br-[60px] overflow-hidden">
					<img src="/assets/img/img-herobanner.png" alt="Ben Ricciardi" class="absolute inset-0 w-full h-full object-cover" />
					<div class="absolute bottom-4 left-4 right-4">
						<div class="relative max-w-[350px]">
							<img src="/assets/vector-1.svg" alt="" class="w-full" />
							<div class="absolute top-[5rem] -translate-y-1/2 left-[20.97px] max-w-[282px]">
								<p class="text-black text-xl font-aktiv italic leading-6 tracking-[-0.4px]">
									Nestled in a serene setting, our club boasts a meticulously designed course that challenges and inspires golfers of all abilities.
								</p>
							</div>
							<button class="absolute bottom-[11px] left-[18px] w-12 h-12 bg-[#d63a2e] rounded-full flex items-center justify-center">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
								</svg>
							</button>
						</div>
					</div>
				</div>

				<!-- CTA Button -->
				<a href="#" class="flex items-center bg-white rounded-full px-8 py-4 w-[208px]">
					<span class="text-black text-xl font-aktiv-bold leading-[30px] tracking-[-0.8px] mr-3 whitespace-nowrap">More about</span>
					<div class="bg-[#d63a2e] rounded-full w-10 h-10 flex items-center justify-center shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 18 18" fill="none">
							<path fill-rule="evenodd" clip-rule="evenodd" d="M14.2163 8.10001L8.0837 1.96651L9.3563 0.693909L17.6624 9.00001L9.3554 17.3061L8.0837 16.0335L14.2163 9.90001H1.0502V8.10001H14.2163Z" fill="white"/>
						</svg>
					</div>
				</a>
			</div>
		</section>

		<!-- About Section -->
		<section class="px-5 pb-20">
			<div class="flex flex-col gap-10 items-start w-full  mx-auto">
				<!-- Section Header -->
				<div class="flex justify-between items-start w-full h-[30px]">
					<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">01</div>
					<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">ABOUT</div>
				</div>

				<!-- About Content -->
				<div class="flex flex-col gap-5 w-full">
					<!-- Image and Title -->
					<div class="flex flex-col gap-10">
						<div class="h-auto overflow-hidden">
							<img src="/assets/img/rectangle-1.png" alt="Ben Ricciardi" class="w-full h-full object-cover" />
						</div>
						<h2 class="text-white text-[90px] font-gazzetta-bold uppercase leading-[84px] break-words">Who's Ben?</h2>
					</div>

					<!-- Description -->
					<p class="text-white text-[32px] font-aktiv-medium leading-[44px] tracking-[-2px]">
						Dynamic, ambitious, and unstoppable <span class="font-aktiv-bold text-[#d63a2e]">Ben</span> is not just a golfer, but a <span class="font-aktiv-medium italic">connector</span> of people and <span class="font-aktiv-medium italic">opportunities</span>.<br><br>
						<span class="text-[22px] font-aktiv-light tracking-[-0.4px] leading-none">With an impressive presence on and off the course, he combines his love for golf with his passion for building powerful business relationships. Every swing tells a story of discipline, focus, and determination — qualities that also define his professional life.</span>
					</p>
				</div>

				<!-- Golf is more than a game -->
				<div class="flex flex-col gap-5 w-full mt-5">
					<h3 class="text-white text-[40px] font-aktiv-bold leading-[39px] tracking-[-2px] text-left">Golf is more than a game</h3>
					<p class="text-[#707070] text-xl font-aktiv-light leading-8 text-left">
						Beyond the course, our club offers a range of world-class amenities, including a modern clubhouse, fine dining, professional golf instruction, and a pro shop stocked with the latest gear.
					</p>
					<div class="flex items-center gap-4">
						<p class="text-white text-xl font-aktiv-medium leading-[30px] tracking-[-0.4px]">Ready to join us? Let's talk</p>
						<div class="bg-[#d63a2e] rounded-full w-8 h-8 flex items-center justify-center shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
								<path fill-rule="evenodd" clip-rule="evenodd" d="M14.2163 8.10001L8.0837 1.96651L9.3563 0.693909L17.6624 9.00001L9.3554 17.3061L8.0837 16.0335L14.2163 9.90001H1.0502V8.10001H14.2163Z" fill="white"/>
							</svg>
						</div>
					</div>
				</div>

				<!-- Videos -->
				<div class="flex flex-col gap-5 w-full mt-5">
					<div class="relative h-[242px] w-full rounded-[10px] overflow-hidden">
						<img src="/assets/img/maxresdefault-webp-1.png" alt="Video 1" class="absolute inset-0 w-full h-full object-cover" />
						<div class="absolute inset-0 bg-black/20 z-10"></div>
						<div class="absolute inset-0 flex items-center justify-center z-20">
							<div class="bg-white/43 rounded-full w-14 h-14 flex items-center justify-center border border-white">
								<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
									<path d="M8 5v14l11-7z"/>
								</svg>
							</div>
						</div>
					</div>
					<div class="relative h-[242px] w-full rounded-[10px] overflow-hidden">
						<img src="/assets/img/maxresdefault-webp-2.png" alt="Video 2" class="absolute inset-0 w-full h-full object-cover" />
						<div class="absolute inset-0 bg-black/20 z-10"></div>
						<div class="absolute inset-0 flex items-center justify-center z-20">
							<div class="bg-white/43 rounded-full w-14 h-14 flex items-center justify-center border border-white">
								<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
									<path d="M8 5v14l11-7z"/>
								</svg>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Latest Content Section -->
		<section class="px-3 pb-20">
			<div class="flex flex-col gap-10 items-center w-full  mx-auto">
				<!-- Section Header -->
				<div class="flex justify-between items-start w-full h-[30px]">
					<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">02</div>
					<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">Highlights</div>
				</div>

				<h2 class="text-white text-[90px] font-gazzetta-bold uppercase leading-[84px] text-center break-words">Latest content</h2>

				<!-- 3D Carousel Slider -->
				<div class="relative w-full h-[324px] flex items-center justify-center">
					<div class="carousel-container relative w-full h-full perspective-1000 flex items-center justify-center">
						<div class="carousel-track-mobile relative w-full h-[324px] transform-style-preserve-3d transition-transform duration-700 ease-out flex items-center justify-center" id="carouselTrackMobile">
							<!-- Slide 1 -->
							<div class="carousel-slide-mobile absolute w-[calc(100%-40px)] h-[280px] transition-all duration-700 ease-out" data-index="0">
								<div class="relative w-full h-full rounded-[20px] overflow-hidden shadow-2xl transform translate-z-0">
									<img 
										src="/assets/img/thumb-1.jpg" 
										alt="Golf course with mountain view" 
										class="w-full h-full object-cover"
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
								</div>
							</div>
							
							<!-- Slide 2 -->
							<div class="carousel-slide-mobile absolute w-full h-[324px] transition-all duration-700 ease-out" data-index="1">
								<div class="relative w-full h-full rounded-[20px] overflow-hidden shadow-2xl transform translate-z-0">
									<img 
										src="/assets/img/thumb-2.jpg" 
										alt="Golfer in action" 
										class="w-full h-full object-cover"
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
								</div>
							</div>
							
							<!-- Slide 3 -->
							<div class="carousel-slide-mobile absolute w-[calc(100%-40px)] h-[280px] transition-all duration-700 ease-out" data-index="2">
								<div class="relative w-full h-full rounded-[20px] overflow-hidden shadow-2xl transform translate-z-0">
									<img 
										src="/assets/img/portrait.png" 
										alt="Golf ball close-up" 
										class="w-full h-full object-cover"
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
								</div>
							</div>
						</div>
						
						<!-- Navigation Arrows -->
						<button 
							id="prevBtnMobile"
							class="carousel-nav carousel-prev absolute left-2 top-1/2 transform -translate-y-1/2 z-20 w-8 h-8 bg-[#d63a2e] rounded-full flex items-center justify-center hover:bg-red-600 transition-colors duration-200 shadow-lg cursor-pointer"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
								<path fill-rule="evenodd" clip-rule="evenodd" d="M3.95371 9.90005L10.0863 16.0336L8.81371 17.3062L0.507612 9.00005L8.81461 0.693953L10.0863 1.96655L3.95371 8.10005L17.1198 8.10005L17.1198 9.90005L3.95371 9.90005Z" fill="white"/>
							</svg>
						</button>
						
						<button 
							id="nextBtnMobile"
							class="carousel-nav carousel-next absolute right-2 top-1/2 transform -translate-y-1/2 z-20 w-8 h-8 bg-[#d63a2e] rounded-full flex items-center justify-center hover:bg-red-600 transition-colors duration-200 shadow-lg cursor-pointer"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
								<path fill-rule="evenodd" clip-rule="evenodd" d="M14.0463 8.09995L7.91369 1.96645L9.18629 0.693848L17.4924 8.99995L9.18539 17.306L7.91369 16.0334L14.0463 9.89995H0.880188V8.09995H14.0463Z" fill="white"/>
							</svg>
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Golf Achievements Section -->
		<section class="pb-20 relative">
			<div class="flex flex-col gap-10 items-start w-full  mx-auto">
				<!-- Section Header -->
				<div class="px-5 flex justify-between items-start w-full h-[30px]">
					<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">02</div>
					<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">golf achievements</div>
				</div>

				<h2 class="text-white text-[90px] font-gazzetta-bold uppercase leading-[80px] px-5 break-words">Mentality that conquered<br>business</h2>

				<!-- Timeline would go here - simplified for mobile -->
				<div class="w-full flex flex-col justify-center items-center my-10 relative overflow-hidden">
					<div class="relative w-[calc(75vw+17rem)] h-[calc((75vw+17rem)/2)] overflow-hidden">
						<!-- Center logo - positioned at top center, in front -->
						<div class="absolute top-0 left-1/2 -translate-x-1/2 z-10 w-[52px] h-[52px] border border-white rounded-lg">
							<img src="/assets/img/rectangle-3.png" alt="Achievement" class="w-full h-full object-cover rounded-lg" />
						</div>
						
						<!-- Outer circle with border - bottom half only, arching downward -->
						<div class="absolute bottom-0 left-1/2 -translate-x-1/2 bg-black w-[calc(75vw+17rem)] h-[calc(75vw+17rem)] aspect-square rounded-full border-[3rem] border-neutral-800 flex items-center justify-center">
							<!-- Inner circle -->
							<div class="bg-black w-[calc(75vw+7.5rem)] aspect-square rounded-full border border-neutral-800 flex items-center justify-center">
							</div>
						</div>
						
						<!-- Vertical line down center of grey border -->
						<div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-px h-[3rem] bg-[#D63A2E] z-10"></div>
						
						<!-- Years positioned around the arc -->
						<div class="absolute inset-0 flex items-center justify-center">
							<!-- 2025 - left side arc -->
							<div class="absolute text-white font-aktiv-medium text-lg" style="bottom: 64%; left: 24%; transform: rotate(-39deg);">
								2025
							</div>
							<!-- 2024 - center bottom, vertical -->
							<div class="absolute text-white font-aktiv-medium text-lg" style="bottom: 38%; left: 50%; transform: translateX(-50%) rotate(90deg);">
								2024
							</div>
							<!-- 2023 - right side arc -->
							<div class="absolute text-white font-aktiv-medium text-lg" style="bottom: 64%; right: 24%; transform: rotate(39deg);">
								2023
							</div>
						</div>
					</div>
					<div class="w-6 h-6 relative bg-red-600 rounded mt-6"></div>
				</div>

				<div class="px-5 flex flex-col gap-5 w-full">
					<h3 class="text-white text-2xl font-aktiv-medium uppercase tracking-[3px]">Expert Line</h3>
					<p class="text-[#bfbfbf] text-xl font-aktiv leading-8">
						Beyond the course, our club offers a range of world-class amenities, including a modern clubhouse, fine dining, professional golf instruction, and a pro shop stocked with the latest gear.
					</p>
				</div>
			</div>
		</section>

		<!-- Reviews Section -->
		<section class="px-5 pb-20">
			<div class="flex flex-col gap-10 items-start w-full  mx-auto">
				<!-- Section Header -->
				<div class="flex justify-between items-start w-full h-[30px]">
					<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">04</div>
					<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">reviews</div>
				</div>

				<div class="flex flex-col gap-5 w-full">
					<p class="text-white text-[32px] font-aktiv-medium leading-[42px] tracking-[-1px] text-left">
						"For <span class="font-aktiv-bold text-[#d63a2e]">Ben</span>, golf is the gateway to opportunities. He believes that the best partnerships are built while walking the fairway. By combining vision, energy, and strategy, he connects with leaders and entrepreneurs, turning a shared passion for golf into successful business ventures."
					</p>

					<div class="relative h-[355px] w-full rounded-[12px] rounded-br-[40px] overflow-hidden">
						<img src="/assets/img/portrait.png" alt="Portrait" class="absolute inset-0 w-full h-full object-cover" />
						<div class="absolute top-6 left-5">
							<h3 class="text-white text-[40px] font-gazzetta uppercase leading-9">
								Where passion for the game<br>meets the success.
							</h3>
						</div>
						<div class="absolute bottom-20 left-4 text-white text-base font-aktiv-medium tracking-[-1.04px]">EXCLUSIVITY</div>
						<div class="absolute bottom-16 left-1/2 -translate-x-1/2 text-white text-base font-aktiv-medium tracking-[-1.04px]">EXCELLENCE</div>
						<div class="absolute bottom-10 right-4 text-white text-base font-aktiv-medium tracking-[-1.04px]">COMMUNITY</div>
					</div>

					<a href="#" class="flex items-center justify-between border border-white rounded-xl px-5 py-4 w-full max-w-[180px]">
						<span class="text-white text-base font-aktiv-medium tracking-[-0.4px]">Let's talk</span>
						<div class="bg-[#d63a2e] rounded-full w-8 h-8 flex items-center justify-center">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
								<path fill-rule="evenodd" clip-rule="evenodd" d="M14.2163 8.10001L8.0837 1.96651L9.3563 0.693909L17.6624 9.00001L9.3554 17.3061L8.0837 16.0335L14.2163 9.90001H1.0502V8.10001H14.2163Z" fill="white"/>
							</svg>
						</div>
					</a>
				</div>
			</div>
		</section>

		<!-- Quick Tips Section -->
		<section class="px-5 pb-20">
			<div class="flex flex-col gap-10 items-center w-full  mx-auto">
				<div class="flex flex-col gap-10 items-start w-full">
					<!-- Section Header -->
					<div class="flex justify-between items-start w-full h-[30px]">
						<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">05</div>
						<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">tips & more</div>
					</div>

					<h2 class="text-white text-[90px] font-gazzetta-bold uppercase leading-[80px] break-words">Quick tips</h2>
				</div>

				<div class="flex flex-col gap-[30px] w-full">
					<!-- Tip 01 -->
					<div class="border-t border-[rgba(154,154,154,0.4)] flex flex-col gap-5 pt-5">
						<div class="flex items-start gap-4 py-[10px]">
							<div class="text-[#d63a2e] text-[32px] font-aktiv-bold leading-9 tracking-[-1.6px] w-[54px] shrink-0">01</div>
							<div class="flex flex-col gap-3 flex-1">
								<h3 class="text-white text-[28px] font-aktiv-bold leading-[37px] tracking-[-1px]">Advice</h3>
								<p class="text-[#707070] text-base font-aktiv-light leading-6">
									Participate in members-only tournaments, social events, and seasonal competitions that bring the community together.
								</p>
							</div>
						</div>
						<div class="h-[230px] rounded-[10px] overflow-hidden">
							<img src="/assets/img/benefits-2.png" alt="Benefits" class="w-full h-full object-cover" />
						</div>
					</div>

					<!-- Tip 02 -->
					<div class="border-t border-[rgba(154,154,154,0.4)] flex flex-col gap-5 pt-5">
						<div class="flex items-start gap-4 py-[10px]">
							<div class="text-[#d63a2e] text-[32px] font-aktiv-bold leading-9 tracking-[-1.6px] w-[54px] shrink-0">02</div>
							<div class="flex flex-col gap-3 flex-1">
								<h3 class="text-white text-[28px] font-aktiv-bold leading-[37px] tracking-[-1px]">Advice</h3>
								<p class="text-[#707070] text-base font-aktiv-light leading-6">
									Participate in members-only tournaments, social events, and seasonal competitions that bring the community together.
								</p>
							</div>
						</div>
						<div class="h-[230px] rounded-[10px] overflow-hidden">
							<img src="/assets/img/benefits-2.png" alt="Benefits" class="w-full h-full object-cover" />
						</div>
					</div>

					<!-- Tip 03 -->
					<div class="border-t border-[rgba(154,154,154,0.4)] flex flex-col gap-5 pt-5">
						<div class="flex items-start gap-4 py-[10px]">
							<div class="text-[#d63a2e] text-[32px] font-aktiv-bold leading-9 tracking-[-1.6px] w-[54px] shrink-0">03</div>
							<div class="flex flex-col gap-3 flex-1">
								<h3 class="text-white text-[28px] font-aktiv-bold leading-[37px] tracking-[-1px]">Advice</h3>
								<p class="text-[#707070] text-base font-aktiv-light leading-6">
									Participate in members-only tournaments, social events, and seasonal competitions that bring the community together.
								</p>
							</div>
						</div>
						<div class="h-[230px] rounded-[10px] overflow-hidden">
							<img src="/assets/img/benefits-2.png" alt="Benefits" class="w-full h-full object-cover" />
						</div>
					</div>
				</div>

				<a href="#" class="flex items-center justify-between border border-white rounded-xl px-5 py-4 w-full max-w-[180px] mt-5">
					<span class="text-white text-base font-aktiv-medium tracking-[-0.4px]">View more</span>
					<div class="bg-[#d63a2e] rounded-full w-8 h-8 flex items-center justify-center">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
							<path fill-rule="evenodd" clip-rule="evenodd" d="M14.2163 8.10001L8.0837 1.96651L9.3563 0.693909L17.6624 9.00001L9.3554 17.3061L8.0837 16.0335L14.2163 9.90001H1.0502V8.10001H14.2163Z" fill="white"/>
						</svg>
					</div>
				</a>
			</div>
		</section>

		<!-- Business Network Section -->
		<section class="px-5 pb-20">
			<div class="flex flex-col gap-10 items-start w-full  mx-auto">
				<!-- Section Header -->
				<div class="flex justify-between items-start w-full h-[30px]">
					<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">06</div>
					<div class="flex gap-4 items-center">
						<div class="w-[25px] h-0.5 bg-[#d63a2e] shrink-0 -mt-0.5"></div>
						<div class="text-white text-base font-aktiv-medium uppercase tracking-[4px]">business</div>
					</div>
				</div>

