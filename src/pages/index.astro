			transform: translateX(-507px) rotateY(-5deg) translateZ(-100px);
		}
		
		.carousel-slide[data-index="1"] {
			transform: translateX(0) rotateY(0deg) translateZ(0px);
		}
		
		.carousel-slide[data-index="2"] {
			transform: translateX(487px) rotateY(5deg) translateZ(-100px);
