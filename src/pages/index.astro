			height: 625px !important;
		}
		
		@media (max-width: 768px) {
			.carousel-slide[data-index="0"],
			.carousel-slide[data-index="2"] {
				display: none;
			}
			
			.carousel-slide[data-index="1"] {
				transform: translateX(0) rotateY(0deg) translateZ(0px);
				opacity: 1;
			}
		}
		
		/* Mobile Carousel Styles */
		.carousel-slide-mobile {
			backface-visibility: hidden;
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
		}
		
		.carousel-slide-mobile[data-index="0"] {
			transform: translateX(-280px) rotateY(-5deg) translateZ(-50px);
		}
		
		.carousel-slide-mobile[data-index="1"] {
			transform: translateX(0) rotateY(0deg) translateZ(0px);
		}
		
		.carousel-slide-mobile[data-index="2"] {
			transform: translateX(280px) rotateY(5deg) translateZ(-50px);
		}
		
		.carousel-slide-mobile.active {
			transform: translateX(0) rotateY(0deg) translateZ(0px) !important;
			opacity: 1 !important;
