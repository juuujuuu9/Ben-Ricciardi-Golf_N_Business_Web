	<style>
		.perspective-1000 {
			perspective: 1000px;
		}
		
		.transform-style-preserve-3d {
			transform-style: preserve-3d;
		}
		
		.carousel-slide {
			backface-visibility: hidden;
		}
		
		.carousel-slide[data-index="0"] {
			transform: translateX(-507px) rotateY(-5deg) translateZ(-100px);
			opacity: 0.6;
		}
		
		.carousel-slide[data-index="1"] {
			transform: translateX(0) rotateY(0deg) translateZ(0px);
			opacity: 1;
			z-index: 10;
		}
		
		.carousel-slide[data-index="2"] {
			transform: translateX(487px) rotateY(5deg) translateZ(-100px);
			opacity: 0.6;
		}
		
		.carousel-slide.active {
			transform: translateX(0) rotateY(0deg) translateZ(0px) !important;
			opacity: 1 !important;
			z-index: 10 !important;
			width: 452px !important;
			height: 757px !important;
		}
		
		.carousel-slide.prev {
			transform: translateX(-487px) rotateY(-5deg) translateZ(-100px) !important;
			opacity: 0.6 !important;
			width: 372px !important;
			height: 625px !important;
		}
		
		.carousel-slide.next {
			transform: translateX(487px) rotateY(5deg) translateZ(-100px) !important;
			opacity: 0.6 !important;
			width: 372px !important;
			height: 625px !important;
		}
		
		@media (max-width: 768px) {
			.carousel-slide[data-index="0"],
			.carousel-slide[data-index="2"] {
				display: none;
			}
			
			.carousel-slide[data-index="1"] {
				transform: translateX(0) rotateY(0deg) translateZ(0px);
				opacity: 1;
			}
		}
	</style>

	<script>
		let currentSlide = 1;
		const totalSlides = 3;
		
		function updateCarousel() {
			const slides = document.querySelectorAll('.carousel-slide');
			const track = document.getElementById('carouselTrack');
			
			slides.forEach((slide, index) => {
				slide.classList.remove('active', 'prev', 'next');
				
				// Reset text sizing
				const title = slide.querySelector('h3');
				const description = slide.querySelector('p');
				const textContainer = slide.querySelector('.absolute.bottom-4, .absolute.bottom-6');
				
				if (index === currentSlide) {
					slide.classList.add('active');
					// Active slide - full size text
					if (title) {
						title.className = 'text-xl font-bold mb-2';
					}
					if (description) {
						description.className = 'text-sm opacity-90';
					}
					if (textContainer) {
						textContainer.className = 'absolute bottom-6 left-6 text-white';
					}
				} else if (index === (currentSlide - 1 + totalSlides) % totalSlides) {
					slide.classList.add('prev');
					// Side slide - smaller text
					if (title) {
						title.className = 'text-lg font-bold mb-1';
					}
					if (description) {
						description.className = 'text-xs opacity-90';
					}
					if (textContainer) {
						textContainer.className = 'absolute bottom-4 left-4 text-white';
					}
				} else if (index === (currentSlide + 1) % totalSlides) {
					slide.classList.add('next');
					// Side slide - smaller text
					if (title) {
						title.className = 'text-lg font-bold mb-1';
					}
					if (description) {
						description.className = 'text-xs opacity-90';
					}
					if (textContainer) {
						textContainer.className = 'absolute bottom-4 left-4 text-white';
					}
				}
			});
		}
		
		function nextSlide() {
			currentSlide = (currentSlide + 1) % totalSlides;
			updateCarousel();
		}
		
		function previousSlide() {
			currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
			updateCarousel();
		}
		
		// Initialize carousel
		document.addEventListener('DOMContentLoaded', function() {
			updateCarousel();
			
			// Add event listeners to buttons
			const prevBtn = document.getElementById('prevBtn');
			const nextBtn = document.getElementById('nextBtn');
			
			if (prevBtn) {
				prevBtn.addEventListener('click', function(e) {
					e.preventDefault();
					previousSlide();
				});
			}
			
			if (nextBtn) {
				nextBtn.addEventListener('click', function(e) {
					e.preventDefault();
					nextSlide();
				});
			}
			
			// Auto-play functionality (optional)
			setInterval(nextSlide, 5000);
		});
		
		// Touch/swipe support for mobile
		let startX = 0;
		let endX = 0;
		
		document.addEventListener('touchstart', function(e) {
			startX = e.touches[0].clientX;
		});
		
		document.addEventListener('touchend', function(e) {
			endX = e.changedTouches[0].clientX;
			handleSwipe();
		});
		
		function handleSwipe() {
			const threshold = 50;
			const diff = startX - endX;
			
			if (Math.abs(diff) > threshold) {
				if (diff > 0) {
					nextSlide();
				} else {
					previousSlide();
				}
			}
		}
		
		// Accordion functionality
		function toggleAccordion(index) {
			const accordionItems = document.querySelectorAll('.accordion-item');
			const accordionContent = accordionItems[index]?.querySelector('.accordion-content');
			const accordionButton = accordionItems[index]?.querySelector('.accordion-header');
			const arrow = accordionButton?.querySelector('.accordion-arrow');
			
			if (!accordionContent || !accordionButton || !arrow) return;
			
			// Check if current item is already open
			const isCurrentlyOpen = accordionContent.style.maxHeight !== '0px' && accordionContent.style.maxHeight !== '';
			
			// If the clicked item is already open, do nothing (prevent jerky animation)
			if (isCurrentlyOpen) {
				return;
			}
			
			// Close all accordion items first
			accordionItems.forEach((item, i) => {
				const content = item.querySelector('.accordion-content');
				const button = item.querySelector('.accordion-header');
				const itemArrow = button?.querySelector('.accordion-arrow');
				
				if (content && itemArrow) {
					content.style.maxHeight = '0';
					// Rotate arrow to point left (closed state)
					itemArrow.style.transform = 'rotate(-90deg)';
					// Remove active state
					button.classList.remove('bg-gray-800/20');
				}
			});
			
			// Open the clicked item
			// Temporarily set max-height to auto to get the full height
			accordionContent.style.maxHeight = 'none';
			const fullHeight = accordionContent.scrollHeight;
			accordionContent.style.maxHeight = '0';
			
			// Use requestAnimationFrame for smooth animation
			requestAnimationFrame(() => {
				accordionContent.style.maxHeight = fullHeight + 'px';
			});
			
			// Rotate arrow to point down (open state)
			arrow.style.transform = 'rotate(0deg)';
			accordionButton.classList.add('bg-gray-800/20');
		}
		
		// Make toggleAccordion globally available
		window.toggleAccordion = toggleAccordion;
		
		// Initialize accordion on page load
		document.addEventListener('DOMContentLoaded', function() {
			// Set initial state for first accordion item (expanded)
			const firstAccordion = document.querySelector('.accordion-item');
			if (firstAccordion) {
				const firstButton = firstAccordion.querySelector('.accordion-header');
				const firstArrow = firstButton?.querySelector('.accordion-arrow');
				
				if (firstButton && firstArrow) {
					firstButton.classList.add('bg-gray-800/20');
					// Set arrow to point down (open state) for first item
					firstArrow.style.transform = 'rotate(0deg)';
				}
			}
			
			// Add event listeners as backup to ensure clicks work
			const accordionButtons = document.querySelectorAll('.accordion-header');
			accordionButtons.forEach((button, index) => {
				button.addEventListener('click', function(e) {
					e.preventDefault();
					window.toggleAccordion(index);
				});
			});
		});
	</script>

